# Trading 212 -> Settings -> API (Beta) -> Generate API key.
# Doporučené oprávnění (scopes) jen pro čtení: account, portfolio, history (dividends, orders, transactions), pies:read.
T212_API_KEY=
# Nové klíče mají i "API Secret" (zobrazí se jen jednou). Starší klíče secret nemají – pak nech prázdné.
T212_API_SECRET=
# live = reálný účet, demo = practice účet
T212_ENV=live

# Volitelné
# PORT=3212
# HISTORY_SYNC_MINUTES=30
